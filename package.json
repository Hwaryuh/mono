{
  "name": "mono-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks || true",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "release": "node scripts/version.mjs release",
    "postrelease": "node scripts/clean-target.mjs --quiet",
    "branding:sync": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-windows-branding.ps1",
    "build": "npm run build --workspace @mono/desktop",
    "clean": "node scripts/clean-target.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "predesktop:dev": "npm run branding:sync",
    "desktop:dev": "npm run tauri --workspace @mono/desktop -- dev",
    "predesktop:build": "npm run branding:sync",
    "desktop:build": "npm run tauri --workspace @mono/desktop -- build",
    "postdesktop:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-desktop-release.ps1"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
