# 실제 Tailscale IPv4로 교체한다. 공인 NIC의 0.0.0.0에는 바인드하지 않는다.
MONO_BIND_ADDR=100.64.0.1:4174
MONO_DB_PATH=/var/lib/mono/mono.sqlite
MONO_SECRET_KEY_PATH=/var/lib/mono/mono.secret.key

# 앱 레벨 인증. Tailscale 밖으로 서버를 노출하면(예: Caddy reverse proxy, tailscale funnel)
# 반드시 설정한다. 설정하면 /health 외 모든 요청에 `Authorization: Bearer <이 값>`을 요구한다.
# 생성: openssl rand -base64 32
# 앱에는 설정 > 서버 > "API 토큰"란에 같은 값을 넣는다.
#MONO_API_TOKEN=

# 오프사이트 백업. 매일 백업(mono-api-backup.timer)은 SQLite+마스터 키를 /var/backups/mono 로,
# R2 미디어 원본을 /var/backups/mono/media 로 미러링한다(앱에 R2 자격증명이 있을 때).
# MONO_BACKUP_REMOTE를 설정하면 그 디렉터리 전체를 이 rclone 원격으로 업로드한다
# (copy — 원격 삭제 없음). 미설정이면 로컬 백업만 돈다.
# 자격증명은 /etc/mono/rclone.conf 에 (예시: deploy/rclone.conf.example).
# 원격 보존은 버킷의 Object Lifecycle Rule로 (예: 30일 후 만료).
# 값은 "<원격이름>:<버킷>/<프리픽스>" 형식.
#MONO_BACKUP_REMOTE=r2:my-bucket/mono
