# 실제 Tailscale IPv4로 교체한다. 공인 NIC의 0.0.0.0에는 바인드하지 않는다.
MONO_BIND_ADDR=100.64.0.1:4174
MONO_DB_PATH=/var/lib/mono/mono.sqlite
MONO_SECRET_KEY_PATH=/var/lib/mono/mono.secret.key

# 앱 레벨 인증. Tailscale 밖으로 서버를 노출하면(예: Caddy reverse proxy, tailscale funnel)
# 반드시 설정한다. 설정하면 /health 외 모든 요청에 `Authorization: Bearer <이 값>`을 요구한다.
# 생성: openssl rand -base64 32
# 앱에는 설정 > 서버 > "API 토큰"란에 같은 값을 넣는다.
#MONO_API_TOKEN=
